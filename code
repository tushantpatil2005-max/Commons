# ---------------------------------------------------------------------------
# Text / vector helpers
# ---------------------------------------------------------------------------


def tokens(text: str, drop_stop: bool = True) -> list[str]:
    parts = re.sub(r"[^a-z0-9]+", " ", text.lower()).split()
    parts = [t for t in parts if len(t) > 1]
    if drop_stop:
        parts = [t for t in parts if t not in STOP]
    return parts


def fnv(s: str) -> int:
    h = 2166136261
    for ch in s:
        h ^= ord(ch)
        h = (h * 16777619) & 0xFFFFFFFF
    return h


def embed(text: str) -> list[float]:
    """Feature-hashed dense vector (vector search; no external embedding API)."""
    v = [0.0] * EMBED_DIM
    toks = tokens(text, drop_stop=False)
    for t in toks:
        h = fnv(t)
        v[h % EMBED_DIM] += 1.0 if (h & 0x100) else -1.0
        if len(t) > 3:
            for i in range(len(t) - 2):
                tri = "#" + t[i : i + 3]
                h2 = fnv(tri)
                v[h2 % EMBED_DIM] += 0.35 * (1.0 if (h2 & 0x100) else -1.0)
    n = math.sqrt(sum(x * x for x in v)) or 1.0
    return [x / n for x in v]


def cosine(a: list[float], b: list[float]) -> float:
    return sum(x * y for x, y in zip(a, b))


def coverage(query: str, text: str) -> float:
    q = tokens(query)
    if not q:
        return 0.0
    hay = f" {text.lower()} "
    return sum(1 for t in q if f" {t}" in hay or t in hay) / len(q)


def strip_machine_labels(text: str) -> str:
    cleaned = re.sub(
        r"(?i)\s*[\(\[]?\s*(ai[- ]generated|generated by (ai|an? (ai|llm|model))|"
        r"as an ai[\w\s]*|powered by ai|created with (ai|chatgpt)|"
        r"this (answer|reply) was (automatically )?generated)\s*[\)\]]?\s*",
        " ",
        text,
    )
    return re.sub(r"\s{2,}", " ", cleaned).strip()


def chunk_text(text: str) -> list[str]:
    paras = [p.strip() for p in re.split(r"\n\s*\n", text) if p.strip()]
    if not paras:
        paras = [text]
    out: list[str] = []
    buf = ""
    for para in paras:
        candidate = f"{buf}\n\n{para}".strip() if buf else para
        if len(candidate) > CHUNK_SIZE and buf:
            out.append(buf)
            tail = buf[-CHUNK_OVERLAP:] if len(buf) > CHUNK_OVERLAP else buf
            buf = f"{tail}\n\n{para}".strip()
        else:
            buf = candidate
        while len(buf) > CHUNK_SIZE:
            out.append(buf[:CHUNK_SIZE])
            buf = buf[CHUNK_SIZE - CHUNK_OVERLAP :]
    if buf:
        out.append(buf)
    return out


