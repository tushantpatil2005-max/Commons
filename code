# ---------------------------------------------------------------------------
# Vector index
# ---------------------------------------------------------------------------


@dataclass
class Chunk:
    id: str
    doc_id: str
    title: str
    category: str
    source: str
    text: str
    vec: list[float]


class VectorIndex:
    """Pure vector search over chunk embeddings (required constraint)."""

    def __init__(self, documents: list[dict]):
        self.chunks: list[Chunk] = []
        for doc in documents:
            for i, text in enumerate(chunk_text(doc["text"])):
                self.chunks.append(
                    Chunk(
                        id=f"{doc['id']}:{i}",
                        doc_id=doc["id"],
                        title=doc["title"],
                        category=doc["category"],
                        source=doc["source"],
                        text=text,
                        vec=embed(text),
                    )
                )

    def search(self, query: str, k: int = TOP_K) -> list[dict]:
        if not self.chunks:
            return []
        q_vec = embed(query)
        scored = []
        for c in self.chunks:
            sim = max(0.0, cosine(q_vec, c.vec))
            # light lexical boost for relevance without leaving vector-first design
            cov = coverage(query, c.text + " " + c.title)
            score = 0.85 * sim + 0.15 * cov
            scored.append(
                {
                    "chunk_id": c.id,
                    "doc_id": c.doc_id,
                    "title": c.title,
                    "category": c.category,
                    "source": c.source,
                    "text": c.text,
                    "similarity": round(sim, 4),
                    "score": round(score, 4),
                }
            )
        scored.sort(key=lambda h: h["score"], reverse=True)
        return scored[:k]


# ---------------------------------------------------------------------------
# Conversation memory
# ---------------------------------------------------------------------------


class ChatMemory:
    def __init__(self):
        self._turns: dict[str, list[dict]] = defaultdict(list)

    def add(self, session_id: str, role: str, content: str, meta: Optional[dict] = None):
        self._turns[session_id].append(
            {"role": role, "content": content, "meta": meta or {}}
        )
        self._turns[session_id] = self._turns[session_id][-20:]

    def history(self, session_id: str) -> list[dict]:
        return list(self._turns.get(session_id, []))

    def prior_user_text(self, session_id: str) -> str:
        return " ".join(
            t["content"] for t in self.history(session_id) if t["role"] == "user"
        )[-500:]


# ---------------------------------------------------------------------------
# Assistant
# ---------------------------------------------------------------------------


class CompanyKnowledgeAssistant:
    def __init__(self):
        self.docs = seed_documents()
        self.index = VectorIndex(self.docs)
        self.memory = ChatMemory()
        self.runs: dict[str, dict] = {}

    def stats(self) -> dict:
        return {
            "app": APP_NAME,
            "documents": len(self.docs),
            "chunks": len(self.index.chunks),
            "categories": sorted({d["category"] for d in self.docs}),
        }

    def retrieve(self, query: str, k: int = TOP_K) -> list[dict]:
        return self.index.search(query, k=k)

    def ask(
        self,
        question: str,
        session_id: Optional[str] = None,
        k: int = TOP_K,
    ) -> dict:
        t0 = time.time()
        session_id = session_id or f"sess_{uuid.uuid4().hex[:8]}"
        q = question.strip()
        self.memory.add(session_id, "user", q)

        # Conversational: fold prior user turns into the retrieval query
        prior = self.memory.prior_user_text(session_id)
        retrieval_query = f"{prior} {q}".strip()
        hits = self.retrieve(retrieval_query, k=k)

        top_text = " ".join(h["text"] for h in hits[:3]) if hits else ""
        cov = coverage(q, top_text) if hits else 0.0
        top_sim = hits[0]["similarity"] if hits else 0.0
        # Corpus-wide coverage: if query terms barely appear anywhere in top hits, abstain
        title_cov = coverage(q, " ".join(h["title"] for h in hits[:3])) if hits else 0.0

        # Graceful missing-information handling
        weak = (
            not hits
            or cov < COVERAGE_MIN
            or (top_sim < 0.28 and cov < 0.35)
            or (title_cov < 0.1 and cov < 0.25)
        )
        if weak:
            answer = (
                "I could not find this in the company knowledge base. "
                "Please rephrase the question or contact People Ops / IT Support for help."
            )
            citations: list[dict] = []
            abstained = True
            confidence = round(min(0.35, top_sim + cov * 0.2), 2)
            relevance = round(cov, 3)
        else:
            citations = []
            for i, h in enumerate(hits[:3], 1):
                citations.append(
                    {
                        "id": i,
                        "doc_id": h["doc_id"],
                        "title": h["title"],
                        "source": h["source"],
                        "category": h["category"],
                        "excerpt": re.sub(r"\s+", " ", h["text"])[:220],
                        "similarity": h["similarity"],
                    }
                )
            sentences = []
            for h in hits[:2]:
                for sent in re.split(r"(?<=[.!?])\s+", h["text"]):
                    sent = sent.strip()
                    if len(sent) < 35:
                        continue
                    if coverage(q, sent) >= 0.12 or coverage(q, h["title"]) >= 0.25:
                        sentences.append(sent)
            if not sentences:
                sentences = [hits[0]["text"][:260]]
            answer = " ".join(sentences[:3])
            if citations:
                answer = f"{answer} [{citations[0]['id']}]"
                if len(citations) > 1:
                    answer = f"{answer} See also [{citations[1]['id']}]."
            abstained = False
            confidence = round(min(0.95, 0.35 + top_sim * 0.4 + cov * 0.25), 2)
            relevance = round(min(1.0, 0.5 * cov + 0.5 * top_sim), 3)

        answer = strip_machine_labels(answer)
        self.memory.add(
            session_id,
            "assistant",
            answer,
            {"citations": citations, "abstained": abstained},
        )

        result = {
            "id": f"ans_{uuid.uuid4().hex[:8]}",
            "session_id": session_id,
            "question": q,
            "answer": answer,
            "abstained": abstained,
            "confidence": confidence,
            "relevance": relevance,
            "citations": citations,
            "retrieval": [
                {
                    "doc_id": h["doc_id"],
                    "title": h["title"],
                    "similarity": h["similarity"],
                    "score": h["score"],
                }
                for h in hits
            ],
            "structured": {
                "action": "abstain" if abstained else "answer",
                "citation_ids": [c["id"] for c in citations],
                "source_refs": [c["source"] for c in citations],
                "top_similarity": round(top_sim, 4),
                "query_coverage": round(cov, 4),
            },
            "timings_ms": round((time.time() - t0) * 1000, 2),
        }
        self.runs[result["id"]] = result
        return result

    def evaluate(self) -> dict:
        """Retrieval + answer metrics on labeled probes."""
        retrieval_hits = 0
        answer_hits = 0
        abstain_correct = 0
        abstain_total = 0
        details = []

        for probe in EVAL_PROBES:
            result = self.ask(probe["question"], session_id=f"eval_{uuid.uuid4().hex[:6]}")
            expected = probe["expected_doc_id"]
            retrieved_ids = [h["doc_id"] for h in result["retrieval"][:3]]

            if expected is None:
                abstain_total += 1
                ok_abs = result["abstained"] is True
                if ok_abs:
                    abstain_correct += 1
                details.append(
                    {
                        "question": probe["question"],
                        "type": "ood",
                        "abstained": result["abstained"],
                        "correct": ok_abs,
                    }
                )
                continue

            top1 = retrieved_ids[0] if retrieved_ids else None
            in_top3 = expected in retrieved_ids
            if top1 == expected or in_top3:
                retrieval_hits += 1

            ans_l = result["answer"].lower()
            must = probe.get("must_include") or []
            content_ok = all(m.lower() in ans_l for m in must) and not result["abstained"]
            if content_ok:
                answer_hits += 1

            details.append(
                {
                    "question": probe["question"],
                    "expected_doc": expected,
                    "top_docs": retrieved_ids,
                    "retrieval_ok": in_top3,
                    "answer_ok": content_ok,
                    "abstained": result["abstained"],
                }
            )

        n_grounded = sum(1 for p in EVAL_PROBES if p["expected_doc_id"])
        return {
            "retrieval_top3_accuracy": round(retrieval_hits / max(1, n_grounded), 3),
            "answer_accuracy": round(answer_hits / max(1, n_grounded), 3),
            "abstain_accuracy": round(abstain_correct / max(1, abstain_total), 3),
            "n_grounded_probes": n_grounded,
            "n_ood_probes": abstain_total,
            "details": details,
        }


# ---------------------------------------------------------------------------
# Self-check
# ---------------------------------------------------------------------------


def self_check() -> list[str]:
    notes: list[str] = []
    bot = CompanyKnowledgeAssistant()
    assert bot.stats()["chunks"] >= bot.stats()["documents"]

    # Vector retrieval + citations
    r1 = bot.ask("How many PTO days do full-time employees receive per year?")
    assert not r1["abstained"]
    assert r1["citations"], "expected source citations"
    assert any(c["doc_id"] == "pol_pto" for c in r1["citations"])
    assert "20" in r1["answer"]
    notes.append(f"pto conf={r1['confidence']} cites={len(r1['citations'])}")

    # Conversational follow-up
    sid = "conv_demo"
    bot.ask("Tell me about remote work limits", session_id=sid)
    r2 = bot.ask("What about the equipment stipend?", session_id=sid)
    assert r2["session_id"] == sid
    assert not r2["abstained"]
    assert "500" in r2["answer"]
    assert len(bot.memory.history(sid)) >= 4
    notes.append(f"follow-up answer has stipend; turns={len(bot.memory.history(sid))}")

    # Missing information
    r3 = bot.ask("What is the company's official pizza topping ranking?")
    assert r3["abstained"] is True
    assert not r3["citations"] or r3["confidence"] < 0.5
    notes.append(f"ood abstained={r3['abstained']}")

    # Source references in structured output
    assert r1["structured"]["source_refs"]
    notes.append(f"source_refs={r1['structured']['source_refs'][:2]}")

    # Evaluation metrics
    metrics = bot.evaluate()
    assert metrics["retrieval_top3_accuracy"] >= 0.5
    assert metrics["answer_accuracy"] >= 0.5
    assert metrics["abstain_accuracy"] >= 0.5
    notes.append(
        f"eval retrieval={metrics['retrieval_top3_accuracy']} "
        f"answer={metrics['answer_accuracy']} abstain={metrics['abstain_accuracy']}"
    )

    blob = json.dumps(r1) + json.dumps(r2)
    assert not re.search(r"(?i)ai[- ]generated|powered by ai|as an ai", blob)
    return notes


# ---------------------------------------------------------------------------
# FastAPI
# ---------------------------------------------------------------------------

if HAS_FASTAPI:
    app = FastAPI(title="Commons — Company Knowledge Assistant", version="1.0.0")
    _bot = CompanyKnowledgeAssistant()

    class AskBody(BaseModel):
        question: str = Field(..., min_length=3)
        session_id: Optional[str] = None
        k: int = TOP_K

    @app.get("/health")
    def health():
        return {"ok": True, **_bot.stats()}

    @app.post("/ask")
    def ask(body: AskBody):
        return _bot.ask(body.question, session_id=body.session_id, k=body.k)

    @app.post("/retrieve")
    def retrieve(body: AskBody):
        return {"query": body.question, "hits": _bot.retrieve(body.question, k=body.k)}

    @app.get("/evaluate")
    def evaluate():
        return _bot.evaluate()


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------


def main():
    parser = argparse.ArgumentParser(description="Company Knowledge Assistant")
    parser.add_argument("--check", action="store_true")
    parser.add_argument("--evaluate", action="store_true")
    parser.add_argument("-q", "--question", type=str)
    parser.add_argument("--session", default=None)
    parser.add_argument("--serve", action="store_true")
    parser.add_argument("--host", default="0.0.0.0")
    parser.add_argument("--port", type=int, default=8000)
    args = parser.parse_args()

    if args.check:
        notes = self_check()
        print("PASS")
        for n in notes:
            print(n)
        return

    bot = CompanyKnowledgeAssistant()

    if args.evaluate:
        print(json.dumps(bot.evaluate(), indent=2))
        return

    if args.serve:
        if not HAS_FASTAPI:
            raise SystemExit("Install fastapi uvicorn: pip install fastapi uvicorn")
        import uvicorn

        uvicorn.run(app, host=args.host, port=args.port)
        return

    if not args.question:
        parser.print_help()
        return

    print(json.dumps(bot.ask(args.question, session_id=args.session), indent=2))


if __name__ == "__main__":
    main()
