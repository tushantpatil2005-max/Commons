APP_NAME = "Commons"
EMBED_DIM = 256
CHUNK_SIZE = 420
CHUNK_OVERLAP = 70
COVERAGE_MIN = 0.20
TOP_K = 5
STOP = set(
    "a an the of to and or for in on with from by as is are was were be this "
    "that it its their our your at into over than then also not no how do i can".split()
